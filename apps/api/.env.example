# Copy to apps/api/.env for local work. In production these come from the server's secret store.
# Every variable the schema knows is listed here (a test enforces it). Blank = capability OFF.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
APP_NAME=Influencer Platform
APP_VERSION=0.1.0

# ---- Database (one PostgreSQL database per client) ----
# DB_PROVIDER picks which URL below is used:  neon | mydb | local
#   neon  -> NEON_DATABASE_URL   (Neon serverless Postgres; use the DIRECT host, not the "-pooler" one, so migrations and jobs work)
#   mydb  -> MYDB_DATABASE_URL   (our own Neon-style hosted Postgres)
#   local -> LOCAL_DATABASE_URL  (Postgres on the same VPS)
# Blank DB_PROVIDER = fall back to plain DATABASE_URL. Switching provider does NOT move data: migrate -> verify -> cut over.
DB_PROVIDER=local
NEON_DATABASE_URL=
MYDB_DATABASE_URL=
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform
DATABASE_URL=

# 32 random bytes, base64. Encrypts two-factor secrets. `openssl rand -base64 32`. Losing it locks users out of 2FA.
APP_ENCRYPTION_KEY=

# Browser UIs allowed to call this API, comma-separated origins (no path, no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Where your UI lives; used to build invitation and reset links
UI_BASE_URL=http://localhost:3000
# Number of reverse proxies in front (1 behind nginx) so the real client IP is used for rate limits and audit
TRUST_PROXY_HOPS=0
# Interactive docs at /docs (default: on outside production)
API_DOCS_ENABLED=true

# Sessions and sign-in protection
SESSION_COOKIE_NAME=sid
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=336
# Defaults to true in production, false otherwise
COOKIE_SECURE=
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Rate limits (per IP, per minute; in-memory, one API process per client)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
# Anonymous write endpoints (checkout, inquiries, meeting booking, RSVP), per IP per minute
RATE_LIMIT_PUBLIC_PER_MIN=20

# Optional capabilities
JOBS_ENABLED=true
AUDIT_LOG_ENABLED=true
# ---- File storage: cloudinary (default) | s3 | local (dev only) | blank = OFF. Switching does NOT move existing files. ----
STORAGE_PROVIDER=cloudinary
STORAGE_LOCAL_DIR=./storage
# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# optional: keeps this client's files under one folder
CLOUDINARY_FOLDER=
# s3 (AWS or S3-compatible: set S3_ENDPOINT for R2 / Wasabi / MinIO; keep the bucket private)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# ---- Email: smtp | console (print to log, development only) | blank = OFF (invitations/resets are handed over as one-time tokens) ----
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
# smtp (587 + SMTP_SECURE=false = STARTTLS; 465 + SMTP_SECURE=true = implicit TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Not chosen yet: leave blank. Any value is rejected until an adapter exists.
AI_PROVIDER=
PAYMENT_PROVIDER=

# Used by `npm run seed` to create the first Super Admin invitation
SUPER_ADMIN_EMAIL=owner@example.com
